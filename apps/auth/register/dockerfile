# Etapa 1: Instalar dependencias
FROM node:20-alpine as dev-deps

WORKDIR /app

# Copiar archivos de dependencias primero para mejor caché
COPY package.json package-lock.json* ./
COPY nx.json ./

# Instalar dependencias globales y locales
RUN npm install -g nx@latest
RUN npm install --legacy-peer-deps

# Etapa 2: Construir la aplicación
FROM node:20-alpine as builder

WORKDIR /app

# Copiar node_modules desde la etapa anterior
COPY --from=dev-deps /app/node_modules ./node_modules

# Copiar el resto de los archivos
COPY . .

# Variables de entorno para construcción
ENV NODE_OPTIONS="--max-old-space-size=4096"

# Construir la aplicación con modo verbose para mejor diagnóstico
RUN npx nx build register --verbose

# Etapa 3: Preparar el entorno de producción
FROM nginx:stable-alpine as prod

EXPOSE 80

# Eliminar configuración por defecto de nginx
RUN rm -rf /etc/nginx/conf.d/default.conf

# Copiar los archivos construidos
COPY --from=builder /app/dist/apps/register /usr/share/nginx/html

# Copiar configuración personalizada de nginx
COPY apps/auth/register/nginx/nginx.conf /etc/nginx/conf.d/default.conf

# Asegurar permisos correctos
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html

CMD ["nginx", "-g", "daemon off;"]